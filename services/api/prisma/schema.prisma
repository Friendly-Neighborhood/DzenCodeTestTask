generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Order {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  title       String    @db.VarChar(120)
  description String    @default("") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@index([createdAt], map: "idx_orders_created_at")
  @@map("orders")
}

model Product {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  serialNumber   String   @map("serial_number") @db.VarChar(80)
  isNew          Boolean  @default(true) @map("is_new")
  photo          String   @default("") @db.VarChar(500)
  title          String   @db.VarChar(160)
  type           String   @db.VarChar(80)
  specification  String   @default("") @db.VarChar(500)
  guaranteeStart DateTime @map("guarantee_start")
  guaranteeEnd   DateTime @map("guarantee_end")
  orderId        Int      @map("order_id") @db.UnsignedInt
  createdAt      DateTime @default(now()) @map("created_at")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  prices         Price[]

  @@index([type], map: "idx_products_type")
  @@index([orderId], map: "idx_products_order_id")
  @@map("products")
}

model Price {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  productId Int     @map("product_id") @db.UnsignedInt
  value     Decimal @db.Decimal(12, 2)
  symbol    String  @db.VarChar(8)
  isDefault Boolean @default(false) @map("is_default")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, symbol], map: "uq_product_currency")
  @@index([productId], map: "idx_prices_product_id")
  @@map("prices")
}
